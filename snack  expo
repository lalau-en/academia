import React, { useState } from 'react';
import { StyleSheet, Text, View, TextInput, TouchableOpacity, FlatList, SafeAreaView, Modal } from 'react-native';

export default function App() {
  const [token, setToken] = useState(null);
  const [email, setEmail] = useState('');
  const [senha, setSenha] = useState('');
  const [logRequisicao, setLogRequisicao] = useState('');

  // Estado para controlar qual aba de treino está ativa ('treinoA' ou 'treinoB')
  const [treinoAtivo, setTreinoAtivo] = useState('treinoA');

  // Banco em memória separado por Treinos
  const [exerciciosTreinoA, setExerciciosTreinoA] = useState([
    { id: '1', nome: 'Supino Reto', grupo: 'Peito', series: '4x12' }
  ]);
  const [exerciciosTreinoB, setExerciciosTreinoB] = useState([
    { id: '2', nome: 'Puxada Alta', grupo: 'Costas', series: '4x10' }
  ]);

  // Estados para Criar e Atualizar
  const [idEditando, setIdEditando] = useState(null);
  const [nome, setNome] = useState('');
  const [grupo, setGrupo] = useState('');
  const [series, setSeries] = useState('');

  // Estado para Detalhar (Modal)
  const [itemDetalhe, setItemDetalhe] = useState(null);

  const registrarLog = (metodo, rota, enviaToken = true) => {
    const authHeader = enviaToken ? `\nHeader -> Authorization: Bearer ${token}` : '';
    setLogRequisicao(`[${metodo}] ${rota}${authHeader}`);
  };

  // 1. LOGIN (Gera Token)
  const fazerLogin = () => {
    if (!email || !senha) return alert('Preencha e-mail e senha');
    const jwtSimulado = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6MX0.TokenValido';
    setToken(jwtSimulado);
    setLogRequisicao(`[POST] /auth/login -> 200 OK\nToken recebido: ${jwtSimulado}`);
  };

  // 2. CRIAR ou 5. ATUALIZAR
  const salvarExercicio = () => {
    if (!nome || !grupo || !series) return alert('Preencha todos os campos');

    const listaAtual = treinoAtivo === 'treinoA' ? exerciciosTreinoA : exerciciosTreinoB;
    const setListaAtual = treinoAtivo === 'treinoA' ? setExerciciosTreinoA : setExerciciosTreinoB;

    if (idEditando) {
      // ATUALIZAR (PUT)
      setListaAtual(listaAtual.map(item => 
        item.id === idEditando ? { ...item, nome, grupo, series } : item
      ));
      registrarLog('PUT', `/${treinoAtivo}/exercicios/${idEditando}`);
      setIdEditando(null);
    } else {
      // CRIAR (POST)
      const novo = { id: String(Date.now()).slice(-4), nome, grupo, series };
      setListaAtual([...listaAtual, novo]);
      registrarLog('POST', `/${treinoAtivo}/exercicios`);
    }
    setNome(''); setGrupo(''); setSeries('');
  };

  // 3. LISTAR (GET)
  const listarTodos = () => {
    registrarLog('GET', `/${treinoAtivo}/exercicios`);
  };

  // 4. DETALHAR UM ELEMENTO (GET /:id)
  const detalharItem = (item) => {
    setItemDetalhe(item);
    registrarLog('GET', `/${treinoAtivo}/exercicios/${item.id}`);
  };

  // Preparar edição
  const iniciarEdicao = (item) => {
    setIdEditando(item.id);
    setNome(item.nome);
    setGrupo(item.grupo);
    setSeries(item.series);
  };

  // 6. EXCLUIR (DELETE /:id)
  const excluirItem = (id) => {
    if (treinoAtivo === 'treinoA') {
      setExerciciosTreinoA(exerciciosTreinoA.filter(item => item.id !== id));
    } else {
      setExerciciosTreinoB(exerciciosTreinoB.filter(item => item.id !== id));
    }
    registrarLog('DELETE', `/${treinoAtivo}/exercicios/${id}`);
  };

  if (!token) {
    return (
      <SafeAreaView style={s.container}>
        <View style={s.center}>
          <Text style={s.logo}>🏋️‍♂️ Login Academia </Text>
          <TextInput style={s.input} placeholder="E-mail" placeholderTextColor="#888" value={email} onChangeText={setEmail} />
          <TextInput style={s.input} placeholder="Senha" placeholderTextColor="#888" secureTextEntry value={senha} onChangeText={setSenha} />
          <TouchableOpacity style={s.btn} onPress={fazerLogin}>
            <Text style={s.btnText}>Entrar</Text>
          </TouchableOpacity>
        </View>
      </SafeAreaView>
    );
  }

  // Define qual lista mostrar com base na aba ativa
  const dadosAtuais = treinoAtivo === 'treinoA' ? exerciciosTreinoA : exerciciosTreinoB;

  return (
    <SafeAreaView style={s.container}>
      <View style={s.header}>
        <Text style={s.title}>CRUD + JWT Ativo</Text>
        <TouchableOpacity onPress={() => setToken(null)}><Text style={s.sair}>Sair</Text></TouchableOpacity>
      </View>

      {/* Seletor de Opções (Treino 1 e Treino 2) */}
      <View style={s.tabContainer}>
        <TouchableOpacity 
          style={[s.tabButton, treinoAtivo === 'treinoA' && s.tabActive]} 
          onPress={() => { setTreinoAtivo('treinoA'); setIdEditando(null); setNome(''); setGrupo(''); setSeries(''); }}
        >
          <Text style={[s.tabText, treinoAtivo === 'treinoA' && s.tabTextActive]}>Treino 1 (A)</Text>
        </TouchableOpacity>
        <TouchableOpacity 
          style={[s.tabButton, treinoAtivo === 'treinoB' && s.tabActive]} 
          onPress={() => { setTreinoAtivo('treinoB'); setIdEditando(null); setNome(''); setGrupo(''); setSeries(''); }}
        >
          <Text style={[s.tabText, treinoAtivo === 'treinoB' && s.tabTextActive]}>Treino 2 (B)</Text>
        </TouchableOpacity>
      </View>

      {/* Caixa de Log mostrando o Token sendo usado nas requisições */}
      <View style={s.logBox}>
        <Text style={s.logTitle}>Última Requisição HTTP:</Text>
        <Text style={s.logText}>{logRequisicao}</Text>
      </View>

      {/* Formulário Criar / Atualizar */}
      <TextInput style={s.input} placeholder="Nome (ex: Agachamento)" placeholderTextColor="#888" value={nome} onChangeText={setNome} />
      <View style={s.row}>
        <TextInput style={[s.input, { flex: 1, marginRight: 5 }]} placeholder="Grupo (ex: Pernas)" placeholderTextColor="#888" value={grupo} onChangeText={setGrupo} />
        <TextInput style={[s.input, { flex: 1 }]} placeholder="Séries (ex: 3x10)" placeholderTextColor="#888" value={series} onChangeText={setSeries} />
      </View>

      <View style={s.row}>
        <TouchableOpacity style={[s.btn, { flex: 2, marginRight: 5 }]} onPress={salvarExercicio}>
          <Text style={s.btnText}>{idEditando ? 'Salvar Edição (PUT)' : 'Criar Novo (POST)'}</Text>
        </TouchableOpacity>
        <TouchableOpacity style={[s.btnSec, { flex: 1 }]} onPress={listarTodos}>
          <Text style={s.btnText}>Listar (GET)</Text>
        </TouchableOpacity>
      </View>

      {/* Lista de Elementos */}
      <FlatList
        data={dadosAtuais}
        keyExtractor={item => item.id}
        renderItem={({ item }) => (
          <View style={s.card}>
            <View style={{ flex: 1 }}>
              <Text style={s.cardTitle}>#{item.id} - {item.nome}</Text>
              <Text style={s.sub}>{item.grupo} • {item.series}</Text>
            </View>
            <View style={s.row}>
              <TouchableOpacity style={[s.badge, s.info]} onPress={() => detalharItem(item)}>
                <Text style={s.badgeText}>Detalhar</Text>
              </TouchableOpacity>
              <TouchableOpacity style={[s.badge, s.warn]} onPress={() => iniciarEdicao(item)}>
                <Text style={s.badgeText}>Editar</Text>
              </TouchableOpacity>
              <TouchableOpacity style={[s.badge, s.danger]} onPress={() => excluirItem(item.id)}>
                <Text style={s.badgeText}>Excluir</Text>
              </TouchableOpacity>
            </View>
          </View>
        )}
      />

      {/* Modal de Detalhes (GET /:id) */}
      <Modal visible={!!itemDetalhe} transparent animationType="fade">
        <View style={s.modalBg}>
          <View style={s.modalBox}>
            <Text style={s.modalTitle}>Detalhes ({treinoAtivo.toUpperCase()} / {itemDetalhe?.id})</Text>
            <Text style={s.modalItem}>ID: {itemDetalhe?.id}</Text>
            <Text style={s.modalItem}>Exercício: {itemDetalhe?.nome}</Text>
            <Text style={s.modalItem}>Grupo Muscular: {itemDetalhe?.grupo}</Text>
            <Text style={s.modalItem}>Séries: {itemDetalhe?.series}</Text>
            <TouchableOpacity style={[s.btn, { marginTop: 15 }]} onPress={() => setItemDetalhe(null)}>
              <Text style={s.btnText}>Fechar</Text>
            </TouchableOpacity>
          </View>
        </View>
      </Modal>
    </SafeAreaView>
  );
}

const s = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#121212', padding: 15 },
  center: { flex: 1, justifyContent: 'center', alignItems: 'center' },
  logo: { fontSize: 24, fontWeight: 'bold', color: '#fff', marginBottom: 20 },
  header: { flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 },
  title: { fontSize: 18, fontWeight: 'bold', color: '#fff' },
  sair: { color: '#ff4444', fontWeight: 'bold' },
  tabContainer: { flexDirection: 'row', marginBottom: 10, backgroundColor: '#1e1e1e', borderRadius: 8, padding: 4 },
  tabButton: { flex: 1, paddingVertical: 10, alignItems: 'center', borderRadius: 6 },
  tabActive: { backgroundColor: '#007AFF' },
  tabText: { color: '#888', fontWeight: 'bold', fontSize: 13 },
  tabTextActive: { color: '#fff' },
  logBox: { backgroundColor: '#1a261d', padding: 10, borderRadius: 8, marginBottom: 12, borderLeftWidth: 4, borderLeftColor: '#4CD964' },
  logTitle: { color: '#4CD964', fontWeight: 'bold', fontSize: 12, marginBottom: 3 },
  logText: { color: '#ccc', fontSize: 11, fontFamily: 'monospace' },
  input: { width: '100%', backgroundColor: '#1e1e1e', color: '#fff', padding: 10, borderRadius: 8, marginBottom: 8, borderWidth: 1, borderColor: '#333' },
  row: { flexDirection: 'row', alignItems: 'center', marginBottom: 8 },
  btn: { backgroundColor: '#007AFF', padding: 12, borderRadius: 8, alignItems: 'center', width: '100%' },
  btnSec: { backgroundColor: '#5856D6', padding: 12, borderRadius: 8, alignItems: 'center' },
  btnText: { color: '#fff', fontWeight: 'bold', fontSize: 13 },
  card: { backgroundColor: '#1e1e1e', padding: 12, borderRadius: 8, marginBottom: 8, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' },
  cardTitle: { color: '#fff', fontWeight: 'bold', fontSize: 14 },
  sub: { color: '#888', fontSize: 12 },
  badge: { paddingVertical: 6, paddingHorizontal: 8, borderRadius: 5, marginLeft: 4 },
  info: { backgroundColor: '#17a2b8' },
  warn: { backgroundColor: '#d39e00' },
  danger: { backgroundColor: '#dc3545' },
  badgeText: { color: '#fff', fontSize: 11, fontWeight: 'bold' },
  modalBg: { flex: 1, backgroundColor: 'rgba(0,0,0,0.7)', justifyContent: 'center', alignItems: 'center', padding: 20 },
  modalBox: { backgroundColor: '#1e1e1e', padding: 20, borderRadius: 10, width: '100%', borderWidth: 1, borderColor: '#333' },
  modalTitle: { color: '#4CD964', fontWeight: 'bold', fontSize: 16, marginBottom: 10 },
  modalItem: { color: '#fff', fontSize: 14, marginBottom: 5 }
});
